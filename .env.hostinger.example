# Copy this to .env.hostinger and fill in your Hostinger FTP credentials.
# Find them in hPanel → Files → FTP Accounts.
# DO NOT commit .env.hostinger (already gitignored below).

HOSTINGER_HOST=ftp.yourdomain.com
HOSTINGER_USER=u123456789.yourdomain
HOSTINGER_PASSWORD=your-ftp-password

# Optional overrides
HOSTINGER_PORT=21
HOSTINGER_SECURE=true
HOSTINGER_REMOTE_DIR=/public_html

# Set to 1 to wipe remote dir before upload (fresh deploy)
HOSTINGER_CLEAN=0

# Set to 1 to skip build (upload existing dist/)
SKIP_BUILD=0
