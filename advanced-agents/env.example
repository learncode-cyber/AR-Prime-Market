# Supabase Configuration
SUPABASE_URL=https://your-project.supabase.co
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key-here
SUPABASE_ANON_KEY=your-anon-key-here

# Telegram Configuration (for CEO Approvals)
TELEGRAM_BOT_TOKEN=your-bot-token-here
TELEGRAM_CHAT_ID=your-chat-id-here

# Email Configuration (Resend)
RESEND_API_KEY=your-resend-key-here

# API Configuration
NODE_ENV=production
PORT=3000
API_BASE_URL=https://your-domain.com

# Agent Configuration
ENABLE_MARKETING_AGENT=true
ENABLE_SUPPORT_AGENT=true
ENABLE_LEARNING_AGENT=true
ENABLE_INVENTORY_AGENT=true
ENABLE_FINANCIAL_AGENT=true
ENABLE_ORDER_AGENT=true
ENABLE_CHRO_AGENT=true
ENABLE_ORCHESTRATOR=true

# Logging
LOG_LEVEL=info
LOG_FILE=./logs/app.log

